{
  "name": "helio-pms-product",
  "version": "1.0.0",
  "private": true,
  "description": "Helio PMS — hotel & hostel property management system. SQLite-backed API + React front end.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "npm --prefix apps/pms-api run dev",
    "api": "npm --prefix apps/pms-api start",
    "api:dev": "npm --prefix apps/pms-api run dev",
    "app": "npm --prefix apps/pms-frontend run dev",
    "app:build": "npm --prefix apps/pms-frontend run build",
    "install:app": "npm --prefix apps/pms-frontend install",
    "verify": "npm --prefix apps/pms-api run verify",
    "verify:business": "npm --prefix apps/pms-api run smoke",
    "verify:screens": "npm --prefix apps/pms-api run screens",
    "verify:ui": "npm --prefix apps/pms-api run ui-check",
    "typecheck": "npm --prefix apps/pms-frontend run lint",
    "demo": "npm --prefix apps/pms-api run demo",
    "verify:auth": "npm --prefix apps/pms-api run auth-check",
    "verify:concurrency": "npm --prefix apps/pms-api run concurrency",
    "verify:backup": "npm --prefix apps/pms-api run backup-check",
    "verify:closeouts": "npm --prefix apps/pms-api run closeout-check",
    "verify:staydates": "npm --prefix apps/pms-api run staydates-check",
    "verify:reports": "npm --prefix apps/pms-api run channelreport-check",
    "verify:messaging": "npm --prefix apps/pms-api run messaging-check",
    "verify:overbooking": "npm --prefix apps/pms-api run overbooking-check",
    "verify:alerts": "npm --prefix apps/pms-api run alerts-check",
    "verify:overbookingfix": "npm --prefix apps/pms-api run overbookingfix-check",
    "verify:walking": "npm --prefix apps/pms-api run walking-check",
    "verify:exposure": "npm --prefix apps/pms-api run exposure-check",
    "verify:beds": "npm --prefix apps/pms-api run beds-check",
    "verify:isolation": "npm --prefix apps/pms-api run isolation-check",
    "verify:tax": "npm --prefix apps/pms-api run tax-check",
    "verify:channelpush": "npm --prefix apps/pms-api run channelpush-check",
    "verify:secrets": "npm --prefix apps/pms-api run secrets-check",
    "verify:offline": "npm --prefix apps/pms-api run offline-check",
    "verify:notify": "npm --prefix apps/pms-api run notify-check",
    "verify:rates": "npm --prefix apps/pms-api run rateplanning-check",
    "verify:all": "npm --prefix apps/pms-api run verify",
    "query-plan": "npm --prefix apps/pms-api run query-plan",
    "bench": "npm --prefix apps/pms-api run bench",
    "backup": "npm --prefix apps/pms-api run backup",
    "restore": "npm --prefix apps/pms-api run restore",
    "verify:tapechart": "npm --prefix apps/pms-api run tapechart-check",
    "verify:otas": "npm --prefix apps/pms-api run ota-check"
  }
}
